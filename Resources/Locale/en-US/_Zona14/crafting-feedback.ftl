# Zona14: feedback shown on the Stalker workbench when a craft attempt matches no recipe.
st-craft-fail-empty = The workbench is empty — add a blueprint and its ingredients.
st-craft-fail-no-recipe = No matching recipe. Put the blueprint and its exact ingredients in the workbench.
st-craft-fail-wrong-bench = This recipe needs a different workbench.
st-craft-fail-missing = Missing ingredient: { $item }.
st-craft-fail-need = Need { $amount }x { $item } — you have { $have }.
st-craft-fail-extra = Remove items that aren't part of the recipe: { $items }.
st-craft-fail-unknown = Craft failed, but the ingredients look right. It has been logged.
